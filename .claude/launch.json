{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "heydesk-frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "serve"],
      "port": 8080
    },
    {
      "name": "heydesk-backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "../heydesk", "uvicorn", "heydesk.main:app", "--reload", "--app-dir", "src"],
      "port": 8000
    }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://heydesk-1.onrender.com/api/:path*" },
    { "source": "/media/:path*", "destination": "https://heydesk-1.onrender.com/media/:path*" },
    { "source": "/pay/:path*", "destination": "https://heydesk-1.onrender.com/pay/:path*" },
    { "source": "/p/:path*", "destination": "https://heydesk-1.onrender.com/p/:path*" },
    { "source": "/demo/:path*", "destination": "https://heydesk-1.onrender.com/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

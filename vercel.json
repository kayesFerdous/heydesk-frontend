{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://manger-chair-flashbulb.ngrok-free.dev/api/:path*" },
    { "source": "/media/:path*", "destination": "https://manger-chair-flashbulb.ngrok-free.dev/media/:path*" },
    { "source": "/pay/:path*", "destination": "https://manger-chair-flashbulb.ngrok-free.dev/pay/:path*" },
    { "source": "/p/:path*", "destination": "https://manger-chair-flashbulb.ngrok-free.dev/p/:path*" },
    { "source": "/demo/:path*", "destination": "https://manger-chair-flashbulb.ngrok-free.dev/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
